# Copie este arquivo para `.env` e preencha com valores reais.
# Nunca commite o `.env` de verdade — ele já está no .gitignore.

# Firebase (frontend — só Auth, variáveis públicas VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase Admin (backend — Auth / verificação de tokens). SEGREDO.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUBSTITUA_PELA_SUA_CHAVE\n-----END PRIVATE KEY-----\n"

# Server
PORT=3000
SKIP_PLAN_VALIDATION=

# MongoDB (localhost para dev, docker-compose override para hostname 'mongo')
MONGODB_URI=mongodb://localhost:27017/arcanaforge

# Resend (e-mail de notificação de propostas de sessão). SEGREDO.
RESEND_API_KEY=
EMAIL_FROM=ArcanaForge <onboarding@resend.dev>

# Cloudflare Tunnel (opcional — só para expor publicamente). SEGREDO.
# Para ativar: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare R2 (avatares — API S3 compatível). SEGREDO.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# Stripe (cobrança). SEGREDO.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SLOT_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/billing?success=1
STRIPE_CANCEL_URL=http://localhost:5173/billing
CLIENT_URL=http://localhost:5173

# Plano/trial
TRIAL_DAYS=14
FREE_PLAN_SLOTS=2
PRO_PLAN_SLOTS=5
TRIAL_PLAN_SLOTS=5

# Google Agenda (opcional — sem isso a integração fica desligada).
# Passo a passo: docs/google-agenda-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
GOOGLE_TOKEN_ENC_KEY=
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/calendar.app.created
DEFAULT_TIMEZONE=America/Sao_Paulo
